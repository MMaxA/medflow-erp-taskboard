# Docker Hub account used as the image namespace
DOCKERHUB_USERNAME=mmaxa
IMAGE_TAG=0.6.3

# Local web port: http://localhost:8080
APP_PORT=8080

# Use a long random alphanumeric value (avoid URL-reserved symbols for this MVP URL format)
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost,http://127.0.0.1
