# Docker Hub account used as the image namespace
DOCKERHUB_USERNAME=mmaxa
IMAGE_TAG=0.6.3

# Local web port: http://localhost:8080
APP_PORT=8080

# Use a random alphanumeric database password because it is embedded in DATABASE_URL.
# Replace both placeholders with unique random secrets before starting.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_SECRET
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost,http://127.0.0.1
APP_ENV=development
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_SEED=false
